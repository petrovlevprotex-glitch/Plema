<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>CRITICAL ERROR</title>
<style>
  body { margin: 0; background: #000; color: #ff0000; font-family: 'Courier New', monospace; text-align: center; display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100vh; user-select: none; overflow: hidden; cursor: none; }
  h1 { font-size: 3em; margin-bottom: 10px; text-shadow: 0 0 20px red; animation: blink 1s infinite; }
  p { font-size: 1.2em; color: #fff; margin: 5px; }
  .tg { color: #ffcc00; font-weight: bold; font-size: 1.8em; margin: 20px 0; }
  input { padding: 15px; font-size: 1.2em; margin: 20px 0; border: 2px solid red; background: #111; color: #fff; text-align: center; width: 300px; outline: none; cursor: text; }
  button { padding: 15px 40px; font-size: 1.2em; background: #ff0000; color: white; border: none; font-weight: bold; cursor: pointer; }
  #status { color: #ff0000; margin-top: 20px; font-size: 1.2em; font-weight: bold; }
  .success { color: #00ff00 !important; text-shadow: 0 0 20px lime; }
  @keyframes blink { 50% { opacity: 0.2; } }
</style>
</head>
<body onclick="goFullscreen()" oncontextmenu="return false;">
  <h1>SYSTEM LOCKED</h1>
  <p>All data encrypted. Hard drive corrupted.</p>
  <p>To restore access, contact:</p>
  <div class="tg">TG: @lev_petrov</div>
  
  <input type="text" id="password" placeholder="Enter decryption key..." autocomplete="off">
  <br>
  <button onclick="check()">UNLOCK</button>
  <div id="status"></div>

  <script>
    // Блокировка закрытия вкладки
    window.addEventListener('beforeunload', function (e) {
        e.preventDefault();
        e.returnValue = '';
    });

    function goFullscreen() {
        if (document.documentElement.requestFullscreen) {
            document.documentElement.requestFullscreen().catch(err => {});
        }
    }
    
    setTimeout(goFullscreen, 1000);

    function check() {
        let pwd = document.getElementById('password').value;
        let status = document.getElementById('status');

        if (pwd === "5680") {
            status.innerText = "ACCESS GRANTED. SYSTEM RESTORED.";
            status.className = "success";
            document.body.style.cursor = 'default'; // Возвращаем курсор
            window.onbeforeunload = null; // Разрешаем закрыть
            
            setTimeout(() => {
                document.body.innerHTML = '<h1 class="success" style="animation: none;">РАЗБЛОКИРОВАНО</h1><p style="color:#fff;">Пароль верный. Ты можешь закрыть эту вкладку.</p>';
            }, 1500);
        } else {
            status.innerText = "ACCESS DENIED. KEY INCORRECT.";
            status.className = "";
        }
    }
  </script>
</body>
</html>
